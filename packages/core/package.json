{
  "name": "@vscx/core",
  "version": "0.1.0",
  "description": "Protocol, transport, discovery, and runtime primitives for VSCX.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aaronccasanova/vscx.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/*.test.*",
    "!dist/.tsbuildinfo",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/*.test.js"
  }
}
